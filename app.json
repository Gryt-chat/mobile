{
  "expo": {
    "name": "Gryt",
    "slug": "gryt-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "gryt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "chat.gryt.mobile",
      "buildNumber": "26",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Gryt uses the microphone so you can talk in voice channels.",
        "NSCameraUsageDescription": "Gryt uses the camera when you turn on video in a voice channel.",
        "UIBackgroundModes": [
          "audio"
        ],
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Gryt connects to servers on your local network, such as one running on your own machine.",
        "NSBonjourServices": [
          "_gryt._tcp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "chat.gryt.mobile",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#111318",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      "@config-plugins/react-native-webrtc",
      "./plugins/withAndroidHighRefreshRate",
      "./plugins/withScreenShare",
      "./plugins/withShareTarget",
      "./plugins/withShareExtension",
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AtkinsonHyperlegibleNext-Regular.ttf",
            "./assets/fonts/AtkinsonHyperlegibleNext-Medium.ttf",
            "./assets/fonts/AtkinsonHyperlegibleNext-SemiBold.ttf",
            "./assets/fonts/AtkinsonHyperlegibleNext-Bold.ttf",
            "./assets/fonts/AtkinsonHyperlegibleNext-ExtraBold.ttf",
            "./assets/fonts/AtkinsonHyperlegibleNext-Italic.ttf",
            "./assets/fonts/AtkinsonHyperlegibleNext-BoldItalic.ttf",
            "./assets/fonts/AtkinsonHyperlegibleMono-Regular.ttf",
            "./assets/fonts/AtkinsonHyperlegibleMono-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gryt uses your photos so you can choose a profile picture or send one in a message.",
          "cameraPermission": "Gryt uses the camera so you can take a picture to send."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset"
    ],
    "extra": {
      "reports": {
        "url": "https://reports.gryt.chat",
        "app": "mobile"
      }
    }
  }
}
